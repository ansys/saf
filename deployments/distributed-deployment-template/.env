# dotenv-linter:off UnorderedKey
DOMAIN_NAME=${DOMAIN_NAME}
TRAEFIK_PORT=${TRAEFIK_PORT}
EXT_NETWORK_NAME=platform_default
APP_IMAGE_VERSION=main
GLOW_DEPLOYMENT=DockerCompose
GLOW_SOLUTION_DEFINITION=saf.solutions.solutionb2b47ed.solution.definition
GLOW_UI_MODULE=saf.solutions.solutionb2b47ed.ui.app

# Solution Docker name
APP_NAME=solutionb2b47ed_0-0-0

# Routing config
ACCESS_URL=solutions.${DOMAIN_NAME}
GLOW_API_PATH_PREFIX=/
GLOW_UI_PATH_PREFIX=/solutionb2b47ed_0-0-0/

# API service config
GLOW_API_CONTAINER_PORT=8000
GLOW_API_NUMBER_OF_WORKERS=8
# dotenv-linter:off QuoteCharacter
GLOW_CORS_ORIGINS=["*"]
# dotenv-linter:on QuoteCharacter

# UI service config
GLOW_UI_CONTAINER_PORT=8001

# HPS service config
GLOW_PRODUCT_INSTANCE_SYSTEM=HPS
GLOW_HPS_HOST=hps.${DOMAIN_NAME}
GLOW_HPS_PORT=${TRAEFIK_PORT}
GLOW_HPS_USERNAME=${PG_USER}
GLOW_HPS_PASSWORD=${PG_PASSWORD}

# Storage config
DATABASE_LOCATION=${APPDATA}/Ansys/portal/solutionb2b47ed
GLOW_PROJECTS_DIR_SOLUTION=./data/projects
GLOW_TRANSACTIONS_DIR_SOLUTION=./data/transactions

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
