{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.d.ts",
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "test/**",
    "out/test/**",
    "out/**/*.test.js",
    "**/*.js"
  ],
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov",
    "json-summary"
  ],
  "require": [
    "ts-node/register"
  ],
  "report-dir": "coverage",
  "temp-dir": ".nyc_output",
  "check-coverage": false,
  "lines": 5,
  "functions": 5,
  "branches": 5,
  "statements": 5,
  "instrument": true,
  "sourceMap": true
}